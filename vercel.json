{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "zeroConfig": true
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/salome_young_farm_logo\\.png",
      "dest": "/frontend/salome_young_farm_logo.png"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!assets/|favicon\\.svg$|icons\\.svg$).*)",
      "dest": "/frontend/index.html"
    }
  ]
}
